{
    "name": "hazel",
    "license": "AGPL-3.0-only",
    "scripts": {
        "build_development": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js",
        "build_production": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.prod.js",
        "build_test": "npm run eslint:check && npm run ts:check && cross-env webpack --config ./webpack/webpack.config.dev.js --env test=true",
        "eslint:check": "eslint **/src",
        "eslint:fix": "eslint **/src --fix",
        "eslint:watch": "nodemon --watch . --ext ts,vue --exec npm run --silent eslint:check",
        "gettext:extract": "vue-gettext-extract",
        "gettext:compile": "vue-gettext-compile",
        "prettier:check": "prettier **/src --check",
        "prettier:fix": "prettier **/src --write",
        "ts:check": "vue-tsc --noEmit",
        "ts:watch": "vue-tsc --watch --noEmit",
        "start": "cross-env webpack serve --config ./webpack/webpack.config.dev.js",
        "vitest": "vitest --run --coverage"
    },
    "dependencies": {
        "arches": "git+https://github.com/flaxandteal/arches.git#03d6569e2e2cfdc932e83ebcad9597a18ef5cca5",
        "arches_search": "git+https://github.com/archesproject/arches-search.git#1a2173f0f1b5365102a3eca2a67262b6d11bf2e9",
        "arches_modular_reports": "git+https://github.com/archesproject/arches-modular-reports.git#0fb51b31a629e1135599a0ab4bbf1fd880c7fa9c",
        "arches_resource_sets": "git+https://github.com/archesproject/arches-resource-sets.git#dce1f2cdec69c6a395eabc114bbf7ad2da8601a7"
    },
    "nodeModulesPaths": {},
    "overrides": {
        "moment-timezone": "^0.5.45",
        "nomnom": "npm:@gerhobbelt/nomnom",
        "rimraf": "^5.0.7",
        "underscore": "^1.13.6",
        "arches": "$arches",
        "arches-modular-reports": "git+https://github.com/archesproject/arches-modular-reports.git#0fb51b31a629e1135599a0ab4bbf1fd880c7fa9c"
    }
}
